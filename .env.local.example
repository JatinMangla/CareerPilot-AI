# ===== AI PROVIDER (required) =====
# Google Gemini, free tier — https://aistudio.google.com/apikey
# Models are chosen per task in lib/gemini.ts (Gemini 3.5/3.6/3.7 Flash).
GEMINI_API_KEY=
# Optional: force a single model for every task, overriding the per-task tiers.
# GEMINI_MODEL=

# ===== CROSS-DEVICE SYNC (optional but recommended) =====
# Free Upstash Redis, or Vercel's Marketplace integration which injects KV_REST_API_*.
# Without these the app still works, but data stays on one device.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Login credentials (single-user app). There are no defaults: production refuses
# to start a session without all three.
AUTH_EMAIL=
AUTH_PASSWORD=
# Any long random string — used to sign the session cookie
AUTH_SECRET=

# ===== HR OUTREACH (send email from your own Gmail) =====
# 1. Turn on 2-Step Verification: https://myaccount.google.com/security
# 2. Create an App Password:       https://myaccount.google.com/apppasswords
#    (16 characters — NOT your Google password; revocable any time)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ===== JOB SOURCES (optional) =====
# Company career boards (Greenhouse/Lever/Ashby) need no key and are the default.
# These add wider aggregator coverage on the "All job sites" tab.
OPENWEBNINJA_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ===== LOGIN CODE EMAIL (optional) =====
# Enables the passwordless "email me a login code" flow — https://resend.com
RESEND_API_KEY=

# ===== GITHUB REVIEW (optional) =====
# A token with no scopes. Reads the same public data, with 5,000 calls an hour
# instead of 60 shared with everyone else on the same Vercel IP.
GITHUB_TOKEN=
